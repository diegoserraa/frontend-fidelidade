# URL base da API (sem barra final). As rotas ficam sob /api.
#   Dev local:  http://localhost:3000/api
#   Produção:   https://backend-fidelidade.onrender.com/api
VITE_API_URL=http://localhost:3000/api

# App do cliente (/app): id da padaria dona deste app. Quando definido, todo
# cliente que faz login/cadastro entra automaticamente no programa dessa padaria.
# Sem isso, o vínculo só nasce quando o balcão lê o QR/CPF do cliente.
VITE_EMPRESA_ID=

# Chave pública do Web Push — precisa ser a MESMA usada em VAPID_PUBLIC_KEY no
# fidelidade-api/.env (gere o par com `npx web-push generate-vapid-keys`).
VITE_VAPID_PUBLIC_KEY=

# Ícone do app instalado + splash inicial: gere PNGs próprios a partir da
# logo cadastrada em Configurações (192x192 e 512x512 de verdade, não a
# mesma imagem redimensionada via CSS) e salve em public/pwa-logo-*.png —
# não use um link externo (ex.: Google Imagens): pode ser invalidado a
# qualquer momento e o serviço de instalação do Android costuma ser mais
# estrito sobre o tamanho declarado bater com o real. Estático de propósito
# — o ícone do PWA só fica certo desde a primeira instalação se já vier
# certo no build. Sem essas variáveis, usa o ícone genérico do Fideliza+
# (valores entre aspas por causa do "#", que o dotenv trataria como
# comentário se não fosse citado).
VITE_EMPRESA_LOGO_URL="/pwa-icon.svg"
VITE_EMPRESA_LOGO_192="/pwa-icon.svg"
VITE_EMPRESA_COR_PRIMARIA="#059669"

# Fundo da splash (nativa + em HTML): cor extraída da própria logo acima
# (não é o corFundo geral do app cadastrado em Configurações — o objetivo
# aqui é a splash combinar com a logo, não com o resto do app).
VITE_EMPRESA_SPLASH_BG="#ffffff"
